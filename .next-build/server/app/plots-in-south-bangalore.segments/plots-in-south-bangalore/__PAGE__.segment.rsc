2:Tc06,{"@context":"https://schema.org","@graph":[{"@type":"CollectionPage","@id":"https://premium-plots.vercel.app/plots-in-south-bangalore#webpage","url":"https://premium-plots.vercel.app/plots-in-south-bangalore","name":"Plots in South Bangalore | Jigani, APC Circle, Kanakapura Road","description":"Residential plots in south Bangalore around Jigani, APC Circle and Kanakapura Road from ₹50 lakh, with BMRDA and RERA details, sizes and site visits.","isPartOf":{"@id":"https://premium-plots.vercel.app/#website"},"about":{"@id":"https://premium-plots.vercel.app/#organization"},"mainEntity":{"@type":"ItemList","numberOfItems":2,"itemListElement":[{"@type":"ListItem","position":1,"name":"Oriaiyan Signature Plotted Developments & Villa Plots","url":"https://premium-plots.vercel.app/projects/oriaiyan-signature-plotted-villa-plots-bengaluru"},{"@type":"ListItem","position":2,"name":"Purva Sounds of Water - Seller-Listed Five-Bedroom Villa","url":"https://premium-plots.vercel.app/projects/purva-sounds-of-water-5bhk-luxury-villa-bannerghatta-road"}]}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://premium-plots.vercel.app"},{"@type":"ListItem","position":2,"name":"Plots in Bangalore","item":"https://premium-plots.vercel.app/plots-in-bangalore"},{"@type":"ListItem","position":3,"name":"South Bengaluru · Jigani, APC Circle & Kanakapura Road","item":"https://premium-plots.vercel.app/plots-in-south-bangalore"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Where exactly are the south Bangalore plots located?","acceptedAnswer":{"@type":"Answer","text":"The register covers APC Circle (Jigani/Anekal), the Jigani industrial hub and Kanakapura Road. Each listing names its own location, and the desk will send the survey numbers and a map pin before a visit."}},{"@type":"Question","name":"Are plots in Jigani approved by BMRDA?","acceptedAnswer":{"@type":"Answer","text":"Layouts in the Jigani and APC Circle bel