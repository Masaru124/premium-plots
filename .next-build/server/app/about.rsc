c:Taa7,{"@context":"https://schema.org","@graph":[{"@type":"AboutPage","@id":"https://www.settyrelators.in/about#webpage","url":"https://www.settyrelators.in/about","name":"About Setty Relators","description":"An independent Bengaluru property advisory and authorised channel partner, and how it vets listings.","about":{"@id":"https://www.settyrelators.in/#organization"},"mainEntity":{"@id":"https://www.settyrelators.in/#organization"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.settyrelators.in"},{"@type":"ListItem","position":2,"name":"About","item":"https://www.settyrelators.in/about"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is Setty Relators?","acceptedAnswer":{"@type":"Answer","text":"Setty Relators is an independent real estate advisory and authorised developer channel partner working in Bengaluru and Dubai. It keeps a register of plots, villas and apartments, checks the documents behind each listing, and accompanies buyers through a site visit, price confirmation and registration."}},{"@type":"Question","name":"How is the desk paid if buyers pay no brokerage?","acceptedAnswer":{"@type":"Answer","text":"The desk is compensated by the developer whose project is being sold, in line with its channel-partner agreement. Buyers pay no brokerage for listings in the register. Statutory costs — stamp duty, registration, and any developer charges — are the buyer’s and should be given to you in writing."}},{"@type":"Question","name":"What does the desk check before listing a project?","acceptedAnswer":{"@type":"Answer","text":"The chain of title and encumbrance certificate, the survey numbers against the approved layout, the sanction from the authority with jurisdiction, the RERA registration for the phase on sale, and the khata or applicable revenue record. Where a listing is a resale, the unit’s own documents are the seller’s responsibility and are flagged as such."}},{"@type":"Question","name":"Which areas does the desk cover?","acceptedAnswer":{"@type":"Answer","text":"In Bengaluru: the airport belt around Devanahalli and Chikkajala, Chikkaballapura and the Nandi Hills foothills, the south industrial belt around APC Circle and Jigani, Kanakapura Road and Bannerghatta Road. Overseas, Dubai Marina and Harbour."}},{"@type":"Question","name":"Does the desk give legal or investment advice?","acceptedAnswer":{"@type":"Answer","text":"No. The desk explains procedure, documents and price bands, and tells you what to verify. Title opinions, tax positions, loan eligibility and FEMA questions belong with your own lawyer, lender or adviser. Nothing on this site is a guarantee of returns."}}]}]}7:["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$c"}}],["$","$Ld",null,{"activePage":"about","children":[["$","nav",null,{"aria-label":"Breadcrumb","className":"shell flex flex-wrap items-center gap-2 py-4 text-[14px] text-[var(--text-soft)]","children":[["$","span","Home",{"className":"flex items-center gap-2","children":[false,["$","$Le",null,{"href":"/","className":"hover:underline","children":"Home"}]]}],["$","span","About",{"className":"flex items-center gap-2","children":[["$","span",null,{"aria-hidden":"true","children":"/"}],["$","span",null,{"aria-current":"page","children":"About"}]]}]]}],["$","section",null,{"className":"shell pb-10 pt-6 lg:pt-8","data-reveal":true,"children":"$Lf"}],"$L10","$L11","$L12","$L13","$L14"]}]],["$L15","$L16"],"$L17"]}]
