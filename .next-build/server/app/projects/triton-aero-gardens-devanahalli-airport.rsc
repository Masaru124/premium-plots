16:Te6c,{"@context":"https://schema.org","@graph":[{"@type":"RealEstateListing","@id":"https://www.settyrelators.in/projects/triton-aero-gardens-devanahalli-airport#listing","url":"https://www.settyrelators.in/projects/triton-aero-gardens-devanahalli-airport","name":"Triton Aero Gardens - Airport Corridor","description":"Triton Aero Gardens by Triton Groups is an iconic luxury residential community situated just 5 minutes from Kempegowda International Airport. Tailored for aviation professionals, global executives, and astute investors seeking high rental yield assets in North Bengaluru's aerospace corridor.","image":["https://images.unsplash.com/photo-1574362848149-11496d93a7c7?auto=format&fit=crop&w=1200&q=80","https://images.unsplash.com/photo-1574362848149-11496d93a7c7?auto=format&fit=crop&w=500&q=60","https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=500&q=60","https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=500&q=60"],"address":{"@type":"PostalAddress","addressLocality":"Bengaluru","addressRegion":"Karnataka","addressCountry":"IN"},"geo":{"@type":"GeoCoordinates","latitude":13.2458,"longitude":77.7121},"offers":{"@type":"Offer","price":5200000,"priceCurrency":"INR","availability":"https://schema.org/InStock","url":"https://www.settyrelators.in/projects/triton-aero-gardens-devanahalli-airport"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.settyrelators.in"},{"@type":"ListItem","position":2,"name":"Projects","item":"https://www.settyrelators.in/projects"},{"@type":"ListItem","position":3,"name":"Triton Aero Gardens - Airport Corridor","item":"https://www.settyrelators.in/projects/triton-aero-gardens-devanahalli-airport"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Where is Triton Aero Gardens - Airport Corridor located?","acceptedAnswer":{"@type":"Answer","text":"Devanahalli (5 mins from Kempegowda International Airport) The desk lists Kempegowda International Airport at roughly 5 mins from the site. Confirm the exact gate and route before relying on journey times."}},{"@type":"Question","name":"What is the current price range for Triton Aero Gardens - Airport Corridor?","acceptedAnswer":{"@type":"Answer","text":"The register currently shows ₹52 Lakhs - ₹1.5 Crore. Prices here are quoted by the developer or seller and change with inventory, so ask the desk to reconfirm the current quote before you plan a purchase."}},{"@type":"Question","name":"What sizes or configurations are available here?","acceptedAnswer":{"@type":"Answer","text":"Sizes listed in the register: 850 sq.ft (1.5 BHK); 1200 sq.ft (2 BHK); 1650 sq.ft (3 BHK Premium); 2050 sq.ft (3 BHK + Maid). Ask for the current availability sheet, because unsold inventory changes week to week."}},{"@type":"Question","name":"Is Triton Aero Gardens - Airport Corridor approved and RERA registered?","acceptedAnswer":{"@type":"Answer","text":"BIAPPA & RERA Approved. RERA reference on file: PRM/KA/RERA/1250/303/PR/241201/009100. Verify the registration and unit documents yourself before paying a token amount."}},{"@type":"Question","name":"How many units are still available?","acceptedAnswer":{"@type":"Answer","text":"The register shows 88 of 310 units as available. That figure is a desk snapshot, not a live inventory feed — confirm it before scheduling a visit."}},{"@type":"Question","name":"Can I visit before deciding?","acceptedAnswer":{"@type":"Answer","text":"Yes. Site visits are by appointment and there is no buyer brokerage. Message the desk on WhatsApp with two preferred dates and the team will confirm the slot."}}]}]}d:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$16"}}],"$L17"]
