16:Te55,{"@context":"https://schema.org","@graph":[{"@type":"RealEstateListing","@id":"https://premium-plots.vercel.app/projects/sun-valley-plots-chikkaballapura-d1#listing","url":"https://premium-plots.vercel.app/projects/sun-valley-plots-chikkaballapura-d1","name":"Sun Valley Plotted Enclave - Chikkaballapura","description":"Sun Valley by D1 Projects is a serene, beautifully master-planned plotted development located in Chikkaballapura near the Nandi Hills belt. Offering residential plots priced attractively from ₹35 Lakhs to ₹90 Lakhs with blacktop roads, dedicated children play parks, and immediate registration.","image":["https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1200&q=80","https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=500&q=60","https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=500&q=60","https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=500&q=60"],"address":{"@type":"PostalAddress","addressLocality":"Bengaluru","addressRegion":"Karnataka","addressCountry":"IN"},"geo":{"@type":"GeoCoordinates","latitude":13.432,"longitude":77.726},"offers":{"@type":"Offer","price":3500000,"priceCurrency":"INR","availability":"https://schema.org/InStock","url":"https://premium-plots.vercel.app/projects/sun-valley-plots-chikkaballapura-d1"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://premium-plots.vercel.app"},{"@type":"ListItem","position":2,"name":"Projects","item":"https://premium-plots.vercel.app/projects"},{"@type":"ListItem","position":3,"name":"Sun Valley Plotted Enclave - Chikkaballapura","item":"https://premium-plots.vercel.app/projects/sun-valley-plots-chikkaballapura-d1"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Where is Sun Valley Plotted Enclave - Chikkaballapura located?","acceptedAnswer":{"@type":"Answer","text":"Chikkaballapura (Near Nandi Hills Foothills) The desk lists Nandi Hills Base Road at roughly 12 mins from the site. Confirm the exact gate and route before relying on journey times."}},{"@type":"Question","name":"What is the current price range for Sun Valley Plotted Enclave - Chikkaballapura?","acceptedAnswer":{"@type":"Answer","text":"The register currently shows ₹35 Lakhs - ₹90 Lakhs. Prices here are quoted by the developer or seller and change with inventory, so ask the desk to reconfirm the current quote before you plan a purchase."}},{"@type":"Question","name":"What sizes or configurations are available here?","acceptedAnswer":{"@type":"Answer","text":"Sizes listed in the register: 1200 sq.ft (30x40); 1500 sq.ft (30x50); 2400 sq.ft (40x60). Ask for the current availability sheet, because unsold inventory changes week to week."}},{"@type":"Question","name":"Is Sun Valley Plotted Enclave - Chikkaballapura approved and RERA registered?","acceptedAnswer":{"@type":"Answer","text":"CUDDA & RERA Approved. RERA reference on file: PRM/KA/RERA/1250/303/PR/240918/007120. Verify the registration and unit documents yourself before paying a token amount."}},{"@type":"Question","name":"How many units are still available?","acceptedAnswer":{"@type":"Answer","text":"The register shows 52 of 180 units as available. That figure is a desk snapshot, not a live inventory feed — confirm it before scheduling a visit."}},{"@type":"Question","name":"Can I visit before deciding?","acceptedAnswer":{"@type":"Answer","text":"Yes. Site visits are by appointment and there is no buyer brokerage. Message the desk on WhatsApp with two preferred dates and the team will confirm the slot."}}]}]}d:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$16"}}],"$L17"]
