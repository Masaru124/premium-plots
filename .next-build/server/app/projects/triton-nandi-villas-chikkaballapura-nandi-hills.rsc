17:Tea2,{"@context":"https://schema.org","@graph":[{"@type":"RealEstateListing","@id":"https://premium-plots.vercel.app/projects/triton-nandi-villas-chikkaballapura-nandi-hills#listing","url":"https://premium-plots.vercel.app/projects/triton-nandi-villas-chikkaballapura-nandi-hills","name":"Triton Nandi Luxury Villas (3, 4 & 5 BHK)","description":"Triton Nandi Villas by Triton Groups is a boutique 15-acre gated villa community nestled in the serene foothills of Nandi Hills, Chikkaballapura. Offering 3, 4, and 5 BHK custom architectural villas with private landscaped courtyards, plunge pools, and luxury finishes, priced from ₹2.4 Cr to ₹4.0 Cr.","image":["https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80","https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=500&q=60","https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=500&q=60","https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=500&q=60"],"address":{"@type":"PostalAddress","addressLocality":"Bengaluru","addressRegion":"Karnataka","addressCountry":"IN"},"geo":{"@type":"GeoCoordinates","latitude":13.418,"longitude":77.711},"offers":{"@type":"Offer","price":24000000,"priceCurrency":"INR","availability":"https://schema.org/InStock","url":"https://premium-plots.vercel.app/projects/triton-nandi-villas-chikkaballapura-nandi-hills"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://premium-plots.vercel.app"},{"@type":"ListItem","position":2,"name":"Projects","item":"https://premium-plots.vercel.app/projects"},{"@type":"ListItem","position":3,"name":"Triton Nandi Luxury Villas (3, 4 & 5 BHK)","item":"https://premium-plots.vercel.app/projects/triton-nandi-villas-chikkaballapura-nandi-hills"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Where is Triton Nandi Luxury Villas (3, 4 & 5 BHK) located?","acceptedAnswer":{"@type":"Answer","text":"Chikkaballapura (Nandi Foothills) The desk lists Nandi Hills Scenic Viewpoint at roughly 10 mins from the site. Confirm the exact gate and route before relying on journey times."}},{"@type":"Question","name":"What is the current price range for Triton Nandi Luxury Villas (3, 4 & 5 BHK)?","acceptedAnswer":{"@type":"Answer","text":"The register currently shows ₹2.4 Crore - ₹4.0 Crore. Prices here are quoted by the developer or seller and change with inventory, so ask the desk to reconfirm the current quote before you plan a purchase."}},{"@type":"Question","name":"What sizes or configurations are available here?","acceptedAnswer":{"@type":"Answer","text":"Sizes listed in the register: 2400 sq.ft (3 BHK Villa); 3200 sq.ft (4 BHK Grand Villa); 4500 sq.ft (5 BHK Signature Mansion). Ask for the current availability sheet, because unsold inventory changes week to week."}},{"@type":"Question","name":"Is Triton Nandi Luxury Villas (3, 4 & 5 BHK) approved and RERA registered?","acceptedAnswer":{"@type":"Answer","text":"CUDDA & RERA Approved. RERA reference on file: PRM/KA/RERA/1250/304/PR/250210/009855. Verify the registration and unit documents yourself before paying a token amount."}},{"@type":"Question","name":"How many units are still available?","acceptedAnswer":{"@type":"Answer","text":"The register shows 18 of 65 units as available. That figure is a desk snapshot, not a live inventory feed — confirm it before scheduling a visit."}},{"@type":"Question","name":"Can I visit before deciding?","acceptedAnswer":{"@type":"Answer","text":"Yes. Site visits are by appointment and there is no buyer brokerage. Message the desk on WhatsApp with two preferred dates and the team will confirm the slot."}}]}]}e:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$17"}}],"$L18"]
