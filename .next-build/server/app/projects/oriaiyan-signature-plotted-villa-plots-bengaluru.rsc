17:Tf5f,{"@context":"https://schema.org","@graph":[{"@type":"RealEstateListing","@id":"https://premium-plots.vercel.app/projects/oriaiyan-signature-plotted-villa-plots-bengaluru#listing","url":"https://premium-plots.vercel.app/projects/oriaiyan-signature-plotted-villa-plots-bengaluru","name":"Oriaiyan Signature Plotted Developments & Villa Plots","description":"Oriaiyan Group presents its signature portfolio of residential plots and luxury villa plots spread across six premier growth corridors: Kolar, Chikkaballapura, APC Circle (Jigani/Anekal), Jigani Industrial Hub, Tumkur Road, and Kanakapura Road. Featuring plot dimensions up to 4,499 Sq.Ft with underground cabling, wide avenue trees, and 100% clear titles.","image":["https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1200&q=80","https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=500&q=60","https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=500&q=60","https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=500&q=60"],"address":{"@type":"PostalAddress","addressLocality":"Bengaluru","addressRegion":"Karnataka","addressCountry":"IN"},"geo":{"@type":"GeoCoordinates","latitude":13.4355,"longitude":77.7289},"offers":{"@type":"Offer","price":5000000,"priceCurrency":"INR","availability":"https://schema.org/InStock","url":"https://premium-plots.vercel.app/projects/oriaiyan-signature-plotted-villa-plots-bengaluru"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://premium-plots.vercel.app"},{"@type":"ListItem","position":2,"name":"Projects","item":"https://premium-plots.vercel.app/projects"},{"@type":"ListItem","position":3,"name":"Oriaiyan Signature Plotted Developments & Villa Plots","item":"https://premium-plots.vercel.app/projects/oriaiyan-signature-plotted-villa-plots-bengaluru"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Where is Oriaiyan Signature Plotted Developments & Villa Plots located?","acceptedAnswer":{"@type":"Answer","text":"Kolar, Chikkaballapura, APC Circle, Jigani, Tumkur Rd, Kanakapura Rd The desk lists Chikkaballapura Town & STRR Interchange at roughly 8 mins from the site. Confirm the exact gate and route before relying on journey times."}},{"@type":"Question","name":"What is the current price range for Oriaiyan Signature Plotted Developments & Villa Plots?","acceptedAnswer":{"@type":"Answer","text":"The register currently shows ₹50 Lakhs - ₹2.0 Crore. Prices here are quoted by the developer or seller and change with inventory, so ask the desk to reconfirm the current quote before you plan a purchase."}},{"@type":"Question","name":"What sizes or configurations are available here?","acceptedAnswer":{"@type":"Answer","text":"Sizes listed in the register: 1200 sq.ft (30x40); 1500 sq.ft (30x50); 2400 sq.ft (40x60); 3000 sq.ft (50x60); 4499 sq.ft (Grand Estate). Ask for the current availability sheet, because unsold inventory changes week to week."}},{"@type":"Question","name":"Is Oriaiyan Signature Plotted Developments & Villa Plots approved and RERA registered?","acceptedAnswer":{"@type":"Answer","text":"RERA & Local Town Planning Approved. RERA reference on file: PRM/KA/RERA/1250/303/PR/250112/008890. Verify the registration and unit documents yourself before paying a token amount."}},{"@type":"Question","name":"How many units are still available?","acceptedAnswer":{"@type":"Answer","text":"The register shows 94 of 320 units as available. That figure is a desk snapshot, not a live inventory feed — confirm it before scheduling a visit."}},{"@type":"Question","name":"Can I visit before deciding?","acceptedAnswer":{"@type":"Answer","text":"Yes. Site visits are by appointment and there is no buyer brokerage. Message the desk on WhatsApp with two preferred dates and the team will confirm the slot."}}]}]}e:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$17"}}],"$L18"]
