12:["$","details","Does the desk charge buyers a brokerage?",{"className":"group py-5","children":[["$","summary",null,{"className":"flex min-h-11 cursor-pointer list-none items-start justify-between gap-6 text-[18px] leading-snug text-white transition-colors hover:text-[#E9C349]","children":[["$","span",null,{"children":"Does the desk charge buyers a brokerage?"}],["$","span",null,{"aria-hidden":"true","className":"mt-0.5 shrink-0 text-[#E9C349] transition-transform group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-3 max-w-[66ch] text-[17px] leading-relaxed text-white/70","children":"No. Setty Relators works as an authorised channel partner and is compensated by the developer, so buyers pay no brokerage for listings in the register. Ask for the charges that do apply — registration, stamp duty and any statutory fees — in writing."}]]}]
