16:Ta15,{"@context":"https://schema.org","@graph":[{"@type":"Article","@id":"https://www.settyrelators.in/guides/plot-loan-bangalore#article","headline":"Plot Loan in Bangalore: Eligibility, LTV and Documents","description":"How plot loans work in Bangalore: what lenders check, how much they finance, the documents they ask for, and why construction later needs a separate loan.","url":"https://www.settyrelators.in/guides/plot-loan-bangalore","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.settyrelators.in/guides/plot-loan-bangalore"},"datePublished":"2026-11-26","dateModified":"2026-11-26","inLanguage":"en-IN","author":{"@id":"https://www.settyrelators.in/#organization"},"publisher":{"@id":"https://www.settyrelators.in/#organization"},"about":{"@type":"Thing","name":"Plot loans, without the brochure."},"isAccessibleForFree":true},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.settyrelators.in"},{"@type":"ListItem","position":2,"name":"Guides","item":"https://www.settyrelators.in/guides"},{"@type":"ListItem","position":3,"name":"Plot loans, without the brochure.","item":"https://www.settyrelators.in/guides/plot-loan-bangalore"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How much of a plot’s value will a bank finance?","acceptedAnswer":{"@type":"Answer","text":"Less than a home loan, in most cases, and over a shorter tenure. The exact share depends on the lender, the layout approval and your profile. Ask for the current loan-to-value for your specific plot rather than an advertised maximum."}},{"@type":"Question","name":"Can I get a loan for a plot without approvals?","acceptedAnswer":{"@type":"Answer","text":"Most lenders will not finance an unapproved layout or land classified as agricultural. If a seller says a loan is easy on an unapproved plot, ask which lender has issued a sanction letter for that survey number."}},{"@type":"Question","name":"Does a plot loan cover construction?","acceptedAnswer":{"@type":"Answer","text":"No. Construction needs a separate construction or composite loan, usually applied for with an approved building plan. Ask whether your lender offers a combined product before you register the plot."}},{"@type":"Question","name":"Is a plot loan eligible for tax benefits?","acceptedAnswer":{"@type":"Answer","text":"Tax treatment differs from a home loan and depends on how the land is used and what is built. Confirm the current position with a tax adviser for your case; do not assume home-loan deductions apply to land alone."}}]}]}d:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$16"}}],["$","$L17",null,{"activePage":"guides","children":[["$","nav",null,{"aria-label":"Breadcrumb","className":"shell flex flex-wrap items-center gap-2 py-4 text-[14px] text-[var(--text-soft)]","children":[["$","span","Home",{"className":"flex items-center gap-2","children":[false,["$","$L18",null,{"href":"/","className":"hover:underline","children":"Home"}]]}],["$","span","Guides",{"className":"flex items-center gap-2","children":[["$","span",null,{"aria-hidden":"true","children":"/"}],["$","$L18",null,{"href":"/guides","className":"hover:underline","children":"Guides"}]]}],["$","span","Plot loans, without the brochure.",{"className":"flex items-center gap-2","children":[["$","span",null,{"aria-hidden":"true","children":"/"}],["$","span",null,{"aria-current":"page","children":"Plot loans, without the brochure."}]]}]]}],"$L19"]}]]
