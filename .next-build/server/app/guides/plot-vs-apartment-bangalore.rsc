20:["$","section",null,{"className":"section-navy on-ink page-section","data-reveal":true,"children":["$","div",null,{"className":"shell grid gap-12 lg:grid-cols-12 lg:gap-16","children":[["$","div",null,{"className":"lg:col-span-7","children":["$","div",null,{"children":[["$","h2",null,{"className":"display-lg text-white","children":"Questions on this page."}],["$","div",null,{"className":"mt-8","children":[["$","details","Is a plot a better investment than an apartment in Bangalore?",{"className":"group py-5","children":[["$","summary",null,{"className":"flex min-h-11 cursor-pointer list-none items-start justify-between gap-6 text-[18px] leading-snug text-white transition-colors hover:text-[#E9C349]","children":[["$","span",null,{"children":"Is a plot a better investment than an apartment in Bangalore?"}],["$","span",null,{"aria-hidden":"true","className":"mt-0.5 shrink-0 text-[#E9C349] transition-transform group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-3 max-w-[66ch] text-[17px] leading-relaxed text-white/70","children":"Not by category. A plot can outperform where the corridor gains infrastructure and the title is clean; an apartment can outperform where it produces rent in a working micro-market and the plot corridor stalls. Compare the specific plot and the specific flat on holding cost, loan terms and exit liquidity."}]]}],["$","details","Can I get a home loan for a plot in Bangalore?",{"className":"group py-5","children":[["$","summary",null,{"className":"flex min-h-11 cursor-pointer list-none items-start justify-between gap-6 text-[18px] leading-snug text-white transition-colors hover:text-[#E9C349]","children":[["$","span",null,{"children":"Can I get a home loan for a plot in Bangalore?"}],["$","span",null,{"aria-hidden":"true","className":"mt-0.5 shrink-0 text-[#E9C349] transition-transform group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-3 max-w-[66ch] text-[17px] leading-relaxed text-white/70","children":"Lenders offer plot loans for approved layouts, usually for a smaller share of the value and over a shorter tenure than a home loan, and construction later needs a separate loan. Ask the lender about eligibility for the specific survey number rather than assuming the project qualifies."}]]}],["$","details","Do plots in Bangalore have maintenance charges?",{"className":"group py-5","children":[["$","summary",null,{"className":"flex min-h-11 cursor-pointer list-none items-start justify-between gap-6 text-[18px] leading-snug text-white transition-colors hover:text-[#E9C349]","children":[["$","span",null,{"children":"Do plots in Bangalore have maintenance charges?"}],["$","span",null,{"aria-hidden":"true","className":"mt-0.5 shrink-0 text-[#E9C349] transition-transform group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-3 max-w-[66ch] text-[17px] leading-relaxed text-white/70","children":"A gated plotted layout usually charges for common-area upkeep, security and water once the association is formed. Ask what the current charge is and who collects it before you compare it with an apartment maintenance figure."}]]}],["$","details","Which is easier to sell later?",{"className":"group py-5","children":[["$","summary",null,{"className":"flex min-h-11 cursor-pointer list-none items-start justify-between gap-6 text-[18px] leading-snug text-white transition-colors hover:text-[#E9C349]","children":[["$","span",null,{"children":"Which is easier to sell later?"}],["$","span",null,{"aria-hidden":"true","className":"mt-0.5 shrink-0 text-[#E9C349] transition-transform group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-3 max-w-[66ch] text-[17px] leading-relaxed text-white/70","children":"Apartments generally have a larger buyer pool and sell faster in Bengaluru; plots take longer because the buyer must also be comfortable with title, approval and construction. Liquidity matters if you may need the capital back within a few years."}]]}]]}]]}]}],"$L29"]}]}]
21:["$","td","1",{"className":"py-4 pr-5 align-top text-[16px] leading-relaxed text-[var(--sheet-soft)]","children":"Managed by the association"}]
22:["$","tr","Biggest risk",{"data-ui":true,"children":[["$","th",null,{"scope":"row","className":"py-4 pr-5 align-top text-[16px] font-normal text-[var(--sheet-ink)]","children":"Biggest risk"}],[["$","td","0",{"className":"py-4 pr-5 align-top text-[16px] leading-relaxed text-[var(--sheet-soft)]","children":"Title, approval and access"}],["$","td","1",{"className":"py-4 pr-5 align-top text-[16px] leading-relaxed text-[var(--sheet-soft)]","children":"Builder delivery, and later, ageing stock"}]]]}]
23:["$","section","Cash flow is the first filter",{"id":"cash-flow-is-the-first-filter","className":"mb-12 last:mb-0","data-reveal":true,"children":[["$","h2",null,{"className":"font-heading text-[1.65rem] leading-snug text-[var(--sheet-ink)] sm:text-[2rem]","children":"Cash flow is the first filter"}],[["$","p","An apartment bought for investment pays ",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"An apartment bought for investment pays you while you hold it. A plot pays nothing until something is built, and it costs you tax and upkeep in the meantime. If the plan depends on rental income to service a loan, a plot usually fails that test — the numbers are arithmetic, not opinion."}],["$","p","The desk runs this comparison with buyer",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"The desk runs this comparison with buyers before showing inventory, because the answer changes which corridor and which budget make sense."}]],"$undefined","$undefined"]}]
24:["$","section","Appreciation is a corridor question, not a category question",{"id":"appreciation-is-a-corridor-question-not-a-category-question","className":"mb-12 last:mb-0","data-reveal":true,"children":[["$","h2",null,{"className":"font-heading text-[1.65rem] leading-snug text-[var(--sheet-ink)] sm:text-[2rem]","children":"Appreciation is a corridor question, not a category question"}],[["$","p","Land in a corridor that gains access — a",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"Land in a corridor that gains access — a ring road interchange, a metro extension, an employment cluster — can outperform a building that is ageing in a corridor that has not changed. The reverse is equally true: a plot on a road that never arrives can sit flat for a decade while a flat in a working micro-market pays rent and holds value."}],["$","p","That is why corridor pages on this site ",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"That is why corridor pages on this site list what each corridor is priced against, rather than promising a growth number. Ask what specifically is being built, when it is funded, and what has already been delivered."}]],"$undefined","$undefined"]}]
25:["$","section","Loans and holding costs",{"id":"loans-and-holding-costs","className":"mb-12 last:mb-0","data-reveal":true,"children":[["$","h2",null,{"className":"font-heading text-[1.65rem] leading-snug text-[var(--sheet-ink)] sm:text-[2rem]","children":"Loans and holding costs"}],[["$","p","Plot loans are generally available for a",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"Plot loans are generally available for a smaller share of the value and over a shorter tenure than home loans, and lenders are stricter about approvals and title. Construction after purchase is a separate loan. An apartment loan is a single, longer instrument secured on the unit."}],["$","p","Model the holding cost honestly: propert",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"Model the holding cost honestly: property tax, upkeep, and — for a plot — the years before construction. A plot that costs ₹60 lakh and sits for six years has a real carrying cost even when the price does not move."}]],"$undefined","$undefined"]}]
26:["$","section","Who each one suits",{"id":"who-each-one-suits","className":"mb-12 last:mb-0","data-reveal":true,"children":[["$","h2",null,{"className":"font-heading text-[1.65rem] leading-snug text-[var(--sheet-ink)] sm:text-[2rem]","children":"Who each one suits"}],"$undefined",["$","ul",null,{"className":"mt-5 max-w-[68ch] space-y-3 text-[17px] leading-relaxed text-[var(--sheet-ink)]","children":[["$","li","A plot suits a buyer with a five-to-ten ",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2.5 h-1.5 w-1.5 shrink-0 bg-[var(--gold-on-light)]"}],["$","span",null,{"children":"A plot suits a buyer with a five-to-ten year horizon, capital that does not need to produce income, and patience for paperwork and a build."}]]}],["$","li","An apartment suits a buyer who needs a h",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2.5 h-1.5 w-1.5 shrink-0 bg-[var(--gold-on-light)]"}],["$","span",null,{"children":"An apartment suits a buyer who needs a home soon, wants rent or a managed asset, and prefers a single loan and a single association to deal with."}]]}],["$","li","A villa sits between the two: land plus ",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2.5 h-1.5 w-1.5 shrink-0 bg-[var(--gold-on-light)]"}],["$","span",null,{"children":"A villa sits between the two: land plus a structure, with the maintenance and the premium that come with both."}]]}],["$","li","Neither is universally better. Anyone wh",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2.5 h-1.5 w-1.5 shrink-0 bg-[var(--gold-on-light)]"}],["$","span",null,{"children":"Neither is universally better. Anyone who tells you otherwise without your numbers is selling, not advising."}]]}]]}],"$undefined"]}]
