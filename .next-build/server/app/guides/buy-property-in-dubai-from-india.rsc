1f:["$","div",null,{"className":"lg:col-span-9","children":[[["$","section","Can an Indian resident buy in Dubai?",{"id":"can-an-indian-resident-buy-in-dubai-","className":"mb-12 last:mb-0","data-reveal":true,"children":[["$","h2",null,{"className":"font-heading text-[1.65rem] leading-snug text-[var(--sheet-ink)] sm:text-[2rem]","children":"Can an Indian resident buy in Dubai?"}],[["$","p","Yes, in areas designated as freehold for",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"Yes, in areas designated as freehold for foreign buyers. Dubai Land Department publishes the freehold designation, and the developer’s project should sit inside it. Outside those areas, foreign buyers generally acquire leasehold or an interest through a UAE company, which changes the cost and the exit."}],["$","p","Confirm the designation for the specific",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"Confirm the designation for the specific unit, not for the tower next door. Ask for the title deed type and the DLD registration."}]],"$undefined","$undefined"]}],["$","section","The money side, from India",{"id":"the-money-side-from-india","className":"mb-12 last:mb-0","data-reveal":true,"children":[["$","h2",null,{"className":"font-heading text-[1.65rem] leading-snug text-[var(--sheet-ink)] sm:text-[2rem]","children":"The money side, from India"}],[["$","p","Outward remittance for property is made ",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"Outward remittance for property is made under the Liberalised Remittance Scheme, which is capped per person per financial year. The cap is set by the Reserve Bank of India and can change, so check the current figure with your bank before you sign anything. Payments through informal channels are a compliance problem, not a shortcut."}],["$","p","A mortgage on a Dubai property from an I",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"A mortgage on a Dubai property from an Indian lender is uncommon; UAE banks lend to non-residents on selected projects. Most Indian buyers fund in cash or through a UAE mortgage, so plan the source of funds before the reservation."}]],"$undefined","$undefined"]}],["$","section","Costs on top of the price",{"id":"costs-on-top-of-the-price","className":"mb-12 last:mb-0","data-reveal":true,"children":[["$","h2",null,{"className":"font-heading text-[1.65rem] leading-snug text-[var(--sheet-ink)] sm:text-[2rem]","children":"Costs on top of the price"}],"$undefined","$undefined",["$","div",null,{"className":"mt-6 overflow-x-auto","children":["$","table",null,{"data-ui":true,"className":"w-full border-collapse text-left","children":[["$","caption",null,{"className":"sr-only","children":"Costs commonly quoted in a Dubai purchase"}],["$","thead",null,{"children":["$","tr",null,{"data-ui":true,"children":[["$","th","Item",{"scope":"col","className":"py-3 pr-5 text-[14px] font-normal text-[var(--sheet-soft)]","children":"Item"}],["$","th","Typical basis",{"scope":"col","className":"py-3 pr-5 text-[14px] font-normal text-[var(--sheet-soft)]","children":"Typical basis"}]]}]}],["$","tbody",null,{"children":[["$","tr","DLD transfer fee",{"data-ui":true,"children":[["$","th",null,{"scope":"row","className":"py-4 pr-5 align-top text-[16px] font-normal text-[var(--sheet-ink)]","children":"DLD transfer fee"}],[["$","td","0",{"className":"py-4 pr-5 align-top text-[16px] leading-relaxed text-[var(--sheet-soft)]","children":"A percentage of the price, paid on transfer"}]]]}],["$","tr","Agency commission",{"data-ui":true,"children":[["$","th",null,{"scope":"row","className":"py-4 pr-5 align-top text-[16px] font-normal text-[var(--sheet-ink)]","children":"Agency commission"}],["$L22"]]}],"$L23","$L24","$L25","$L26"]}]]}]}]]}],"$L27","$L28","$L29"],"$L2a"]}]
