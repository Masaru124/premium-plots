27:["$","section","The Golden Visa question",{"id":"the-golden-visa-question","className":"mb-12 last:mb-0","data-reveal":true,"children":[["$","h2",null,{"className":"font-heading text-[1.65rem] leading-snug text-[var(--sheet-ink)] sm:text-[2rem]","children":"The Golden Visa question"}],[["$","p","The ten-year Golden Visa is linked to a ",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"The ten-year Golden Visa is linked to a property investment threshold set by UAE authorities. It is a residency route, not a return, and the threshold and conditions change. Ask the developer or a UAE-licensed adviser for the current requirement in writing rather than accepting a brochure line."}],["$","p","A visa does not make a yield. Rental ret",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"A visa does not make a yield. Rental returns depend on the building, the service charge and the letting market in that specific tower."}]],"$undefined","$undefined"]}]
28:["$","section","Currency and exit",{"id":"currency-and-exit","className":"mb-12 last:mb-0","data-reveal":true,"children":[["$","h2",null,{"className":"font-heading text-[1.65rem] leading-snug text-[var(--sheet-ink)] sm:text-[2rem]","children":"Currency and exit"}],[["$","p","Your return is in dirhams against a rupe",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"Your return is in dirhams against a rupee cost base. A flat that holds its price in AED can still lose money in INR if the rupee strengthens, and the reverse is also true. Model the purchase and the exit in both currencies."}],["$","p","Exit costs mirror entry: agency commissi",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"Exit costs mirror entry: agency commission, DLD fees where applicable and any mortgage settlement. Ask what the resale market in that building actually clears at, not what the launch price was."}]],"$undefined","$undefined"]}]
29:["$","section","What the desk will and will not do",{"id":"what-the-desk-will-and-will-not-do","className":"mb-12 last:mb-0","data-reveal":true,"children":[["$","h2",null,{"className":"font-heading text-[1.65rem] leading-snug text-[var(--sheet-ink)] sm:text-[2rem]","children":"What the desk will and will not do"}],[["$","p","The desk can show the unit, explain the ",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"The desk can show the unit, explain the cost stack, and put you in front of the developer’s documents. It cannot give tax or FEMA advice, and it should not be your only check on a cross-border purchase. Use a qualified adviser for the remittance and tax position."}]],"$undefined","$undefined"]}]
