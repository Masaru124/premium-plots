17:["$","p","A-Khata is the revenue record for a prop",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"A-Khata is the revenue record for a property that has been assessed and entered in the municipal register; it is the record most buyers mean when they say the papers are clear. B-Khata is a separate register for properties that are unassessed or have irregularities, and it carries real risk of higher charges or regularisation later."}]
18:["$","p","e-Khata is the digitised version of the ",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"e-Khata is the digitised version of the khata record. It is a copy of the register entry, not a substitute for reading the sanction, the deed or the survey documents. Verify the khata number on the municipal portal rather than accepting a scanned copy."}]
19:["$","section","What to check on the Karnataka RERA portal",{"id":"what-to-check-on-the-karnataka-rera-portal","className":"mb-12 last:mb-0","data-reveal":true,"children":[["$","h2",null,{"className":"font-heading text-[1.65rem] leading-snug text-[var(--sheet-ink)] sm:text-[2rem]","children":"What to check on the Karnataka RERA portal"}],[["$","p","Search the project name and the promoter",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"Search the project name and the promoter on the Karnataka RERA portal (rera.karnataka.gov.in). A registered project shows its registration number, the promoter, the phase, the declared completion date and the quarterly progress reports where filed. Match the registration to the phase you are being sold — a registered tower does not cover an unregistered extension behind it."}],["$","p","Also check that the person or firm selli",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"Also check that the person or firm selling to you is a registered agent where the law requires it, and read the declared project documents rather than the marketing deck."}]],"$undefined","$undefined"]}]
1a:["$","section","The questions to ask before a token payment",{"id":"the-questions-to-ask-before-a-token-payment","className":"mb-12 last:mb-0","data-reveal":true,"children":[["$","h2",null,{"className":"font-heading text-[1.65rem] leading-snug text-[var(--sheet-ink)] sm:text-[2rem]","children":"The questions to ask before a token payment"}],"$undefined",["$","ul",null,{"className":"mt-5 max-w-[68ch] space-y-3 text-[17px] leading-relaxed text-[var(--sheet-ink)]","children":[["$","li","Which authority sanctioned this layout, ",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2.5 h-1.5 w-1.5 shrink-0 bg-[var(--gold-on-light)]"}],["$","span",null,{"children":"Which authority sanctioned this layout, and what is the sanction number?"}]]}],["$","li","Is this plot number on the approved plan",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2.5 h-1.5 w-1.5 shrink-0 bg-[var(--gold-on-light)]"}],["$","span",null,{"children":"Is this plot number on the approved plan, or in a later unapproved extension?"}]]}],["$","li","Is the khata in the developer name or al",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2.5 h-1.5 w-1.5 shrink-0 bg-[var(--gold-on-light)]"}],["$","span",null,{"children":"Is the khata in the developer name or already split per plot?"}]]}],["$","li","What is the RERA registration number for",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2.5 h-1.5 w-1.5 shrink-0 bg-[var(--gold-on-light)]"}],["$","span",null,{"children":"What is the RERA registration number for this phase, and what does its declared completion date say?"}]]}],["$","li","Who pays for the khata transfer, registr",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2.5 h-1.5 w-1.5 shrink-0 bg-[var(--gold-on-light)]"}],["$","span",null,{"children":"Who pays for the khata transfer, registration and any betterment charges?"}]]}],["$","li","Are there any pending court cases, acqui",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2.5 h-1.5 w-1.5 shrink-0 bg-[var(--gold-on-light)]"}],["$","span",null,{"children":"Are there any pending court cases, acquisitions or road-widening lines on these survey numbers?"}]]}]]}],"$undefined"]}]
1b:["$","section","A practical order of work",{"id":"a-practical-order-of-work","className":"mb-12 last:mb-0","data-reveal":true,"children":[["$","h2",null,{"className":"font-heading text-[1.65rem] leading-snug text-[var(--sheet-ink)] sm:text-[2rem]","children":"A practical order of work"}],[["$","p","Ask for the document set before the site",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"Ask for the document set before the site visit, read it, then visit the land. If the documents are produced only after a booking amount is requested, treat that as the answer to your question. A lawyer independent of the developer should read the chain of title; the desk can explain what each paper does, but it should not be the only pair of eyes on a purchase of this size."}]],"$undefined","$undefined"]}]
1c:["$","div",null,{"className":"mt-14","children":[["$","h2",null,{"className":"font-heading text-[1.5rem] text-[var(--sheet-ink)]","children":"Sources"}],["$","ul",null,{"className":"mt-4 space-y-2 text-[16px]","children":[["$","li","https://bbmp.karnataka.gov.in/BtoAKhata",{"children":["$","a",null,{"href":"https://bbmp.karnataka.gov.in/BtoAKhata","target":"_blank","rel":"noopener noreferrer","className":"text-[var(--sheet-ink)] underline decoration-[var(--gold-on-light)] decoration-2 underline-offset-4","children":"BBMP — A-Khata and e-Khata"}]}],["$","li","https://rera.karnataka.gov.in/",{"children":["$","a",null,{"href":"https://rera.karnataka.gov.in/","target":"_blank","rel":"noopener noreferrer","className":"text-[var(--sheet-ink)] underline decoration-[var(--gold-on-light)] decoration-2 underline-offset-4","children":"Karnataka RERA"}]}],["$","li","https://bmrda.karnataka.gov.in/8/local-planning-areas/en",{"children":["$","a",null,{"href":"https://bmrda.karnataka.gov.in/8/local-planning-areas/en","target":"_blank","rel":"noopener noreferrer","className":"text-[var(--sheet-ink)] underline decoration-[var(--gold-on-light)] decoration-2 underline-offset-4","children":"BMRDA — local planning authorities"}]}]]}],["$","p",null,{"className":"mt-5 max-w-[64ch] text-[15px] leading-relaxed text-[var(--sheet-soft)]","children":"This guide explains procedure and paperwork. It is not legal, tax or investment advice, and it does not replace an independent lawyer or lender check on the specific property."}]]}]
1d:["$","p",null,{"className":"mt-6 text-[15px] leading-relaxed text-[var(--text-soft)]","children":"Images are representational or supplied by the developer or seller. Confirm current pricing, availability and specifications in writing before booking."}]
1e:["$","p",null,{"className":"mt-3 max-w-[66ch] text-[17px] leading-relaxed text-white/70","children":"It can be offered that way, but you should not buy without one. The EC shows registered transactions and charges against the survey number over a chosen period. Ask for a period that runs back to the last transfer, and read it against the deed chain."}]
