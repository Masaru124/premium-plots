10:["$","div",null,{"className":"lg:col-span-9","children":[[["$","section","Which authority sanctions a plot layout?",{"id":"which-authority-sanctions-a-plot-layout-","className":"mb-12 last:mb-0","data-reveal":true,"children":[["$","h2",null,{"className":"font-heading text-[1.65rem] leading-snug text-[var(--sheet-ink)] sm:text-[2rem]","children":"Which authority sanctions a plot layout?"}],[["$","p","The answer depends on where the land sit",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"The answer depends on where the land sits, not on what the brochure prints. Inside Bengaluru city the layout falls to BDA and the khata to BBMP. In the Bengaluru Metropolitan Region but outside the city, BMRDA and its planning authorities apply — BIAAPA covers the airport belt around Devanahalli, and separate planning authorities cover other taluks. Outside those boundaries the local panchayat or town planning authority sanctions the layout."}],["$","p","Some developers advertise \"CUDDA approve",{"className":"mt-4 max-w-[68ch] text-[17px] leading-relaxed text-[var(--sheet-soft)]","children":"Some developers advertise \"CUDDA approved\" layouts. Ask which authority issued the sanction, for which survey numbers, and for the sanction number itself. Confirm that the named authority actually has jurisdiction over that parcel; a sanction from the wrong body does not make the layout legal."}]],"$undefined","$undefined"]}],["$","section","The five documents that matter",{"id":"the-five-documents-that-matter","className":"mb-12 last:mb-0","data-reveal":true,"children":[["$","h2",null,{"className":"font-heading text-[1.65rem] leading-snug text-[var(--sheet-ink)] sm:text-[2rem]","children":"The five documents that matter"}],"$undefined",["$","ul",null,{"className":"mt-5 max-w-[68ch] space-y-3 text-[17px] leading-relaxed text-[var(--sheet-ink)]","children":[["$","li","Sale deed and mother deed, read as a cha",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2.5 h-1.5 w-1.5 shrink-0 bg-[var(--gold-on-light)]"}],["$","span",null,{"children":"Sale deed and mother deed, read as a chain: every transfer should be accounted for, with no gap in ownership."}]]}],["$","li","Encumbrance certificate for the survey n",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2.5 h-1.5 w-1.5 shrink-0 bg-[var(--gold-on-light)]"}],["$","span",null,{"children":"Encumbrance certificate for the survey number, covering the period since the last transfer, showing no unexplained mortgage or charge."}]]}],["$","li","Survey sketch and survey number, matched",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2.5 h-1.5 w-1.5 shrink-0 bg-[var(--gold-on-light)]"}],["$","span",null,{"children":"Survey sketch and survey number, matched against the plot number on the layout plan and the deed."}]]}],["$","li","Khata — A-Khata or the applicable revenu",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2.5 h-1.5 w-1.5 shrink-0 bg-[var(--gold-on-light)]"}],["$","span",null,{"children":"Khata — A-Khata or the applicable revenue record — plus the latest property tax receipt."}]]}],["$","li","Layout sanction and approved plan from t",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2.5 h-1.5 w-1.5 shrink-0 bg-[var(--gold-on-light)]"}],["$","span",null,{"children":"Layout sanction and approved plan from the planning authority, with the RERA registration for the phase being sold."}]]}]]}],"$undefined"]}],["$","section","A-Khata, B-Khata and e-Khata, plainly",{"id":"a-khata-b-khata-and-e-khata-plainly","className":"mb-12 last:mb-0","data-reveal":true,"children":["$L16",["$L17","$L18"],"$undefined","$undefined"]}],"$L19","$L1a","$L1b"],"$L1c"]}]
