2:Tb90,{"@context":"https://schema.org","@graph":[{"@type":"Article","@id":"https://www.settyrelators.in/guides/verify-plot-approvals-bangalore#article","headline":"How to Verify Plot Approvals in Bangalore (Checklist)","description":"A document-by-document check for a Bangalore plot: sanctioning authority, RERA Karnataka registration, A-Khata and e-Khata, survey sketch and encumbrance certificate.","url":"https://www.settyrelators.in/guides/verify-plot-approvals-bangalore","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.settyrelators.in/guides/verify-plot-approvals-bangalore"},"datePublished":"2026-11-26","dateModified":"2026-11-26","inLanguage":"en-IN","author":{"@id":"https://www.settyrelators.in/#organization"},"publisher":{"@id":"https://www.settyrelators.in/#organization"},"about":{"@type":"Thing","name":"How to verify a plot before you pay."},"isAccessibleForFree":true},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.settyrelators.in"},{"@type":"ListItem","position":2,"name":"Guides","item":"https://www.settyrelators.in/guides"},{"@type":"ListItem","position":3,"name":"How to verify a plot before you pay.","item":"https://www.settyrelators.in/guides/verify-plot-approvals-bangalore"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is A-Khata necessary to buy a plot in Bangalore?","acceptedAnswer":{"@type":"Answer","text":"It is the record buyers should expect to see. A plot without a khata, or with a B-Khata entry, needs a clear explanation of why and what regularisation would cost before you commit. Ask for the khata number and verify it on the municipal portal rather than relying on a scanned certificate."}},{"@type":"Question","name":"How do I check if a plot project is RERA registered in Karnataka?","acceptedAnswer":{"@type":"Answer","text":"Search the project and promoter name on rera.karnataka.gov.in. Confirm the registration number, the phase it covers and the declared completion date, and match them to the unit or plot being sold. Registration of one phase does not cover a different, later layout."}},{"@type":"Question","name":"What is the difference between BIAAPA and BMRDA approval?","acceptedAnswer":{"@type":"Answer","text":"BMRDA is the metropolitan region development authority; BIAAPA is one of its planning authorities, covering the Bengaluru airport belt around Devanahalli. Which one applies depends on where the land sits. Ask for the sanction letter and check that the issuing authority has jurisdiction over that survey number."}},{"@type":"Question","name":"Can a plot be sold without an encumbrance certificate?","acceptedAnswer":{"@type":"Answer","text":"It can be offered that way, but you should not buy without one. The EC shows registered transactions and charges against the survey number over a chosen period. Ask for a period that runs back to the last transfer, and read it against the deed chain."}}]}]}0:{"rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","$L3",null,{"activePage":"guides","children":[["$","nav",null,{"aria-label":"Breadcrumb","className":"shell flex flex-wrap items-center gap-2 py-4 text-[14px] text-[var(--text-soft)]","children":[["$","span","Home",{"className":"flex items-center gap-2","children":[false,"$L4"]}],"$L5","$L6"]}],"$L7"]}]],["$L8","$L9"],"$La"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"PvHvQ9PRJzPNPsleu_lYH"}
