7:["$","article",null,{"children":[["$","header",null,{"className":"shell pb-10 pt-6 lg:pt-8","data-reveal":true,"children":[["$","h1",null,{"className":"display-xl max-w-[24ch] text-[#FBFBFD] max-sm:text-[2rem]","children":"How to verify a plot before you pay."}],["$","div",null,{"className":"mt-10 grid gap-10 lg:grid-cols-12 lg:items-start lg:gap-16","children":[["$","div",null,{"className":"lg:col-span-5","children":[["$","p",null,{"className":"text-[15px] text-[var(--text-soft)]","children":[["$","$Lb",null,{"href":"/about","className":"underline decoration-[#D4AF37] decoration-2 underline-offset-4 hover:text-[#E9C349]","children":"Setty Relators desk"}]," ","· Updated"," ",["$","time",null,{"dateTime":"2026-11-26","children":"26 November 2026"}]]}],["$","div",null,{"className":"mt-7 flex flex-wrap items-center gap-x-7 gap-y-3","children":[["$","a",null,{"href":"https://wa.me/918431909508?text=Hello%20Setty%20Relators.%20I%20have%20a%20question%20about%20How%20to%20verify%20a%20plot%20before%20you%20pay.","target":"_blank","rel":"noopener noreferrer","className":"btn-gold","children":"Ask the desk"}],["$","$Lb",null,{"href":"/projects","className":"inline-flex min-h-11 items-center text-[17px] text-[#FBFBFD] underline decoration-[#D4AF37] decoration-2 underline-offset-[6px] hover:text-[#D4AF37]","children":"See the register"}]]}]]}],["$","div",null,{"className":"lg:col-span-7","children":["$","div",null,{"className":"sheet px-6 py-7 sm:px-9 sm:py-9","children":[["$","p",null,{"className":"label label-gold","children":"In short"}],["$","p",null,{"className":"mt-4 text-[18px] leading-relaxed text-[var(--sheet-ink)] sm:text-[19px]","children":"Before paying a token amount for a plot in Bangalore, check five things: the sale deed and its chain of title, the encumbrance certificate, the survey sketch and survey number, the khata (A-Khata or the applicable revenue record), and the layout sanction from the planning authority that has jurisdiction — BIAAPA, BMRDA, BDA or the local town planning body. Then check the project registration on the Karnataka RERA portal. A layout that cannot produce all five is not ready to buy, whatever the brochure shows."}]]}]}]]}]]}],["$","section",null,{"className":"shell pb-4","data-reveal":true,"children":[["$","img",null,{"src":"https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1200&q=80","alt":"How to verify a plot before you pay — Bengaluru property","width":1600,"height":686,"className":"aspect-[21/9] w-full object-cover"}],["$","p",null,{"className":"mt-3 max-w-[70ch] text-[14px] leading-relaxed text-[var(--text-soft)]","children":"Images are representational or supplied by the developer. This guide explains paperwork, not a specific unit."}]]}],["$","div",null,{"className":"bg-[var(--sheet)] text-[var(--sheet-ink)]","children":["$","div",null,{"className":"shell page-section grid gap-14 lg:grid-cols-12 lg:gap-16","children":[["$","aside",null,{"className":"hidden lg:col-span-3 lg:block","children":["$","nav",null,{"aria-label":"On this page","className":"sticky top-28","children":[["$","p",null,{"className":"text-[14px] text-[var(--sheet-soft)]","children":"On this page"}],["$","ul",null,{"className":"mt-4 space-y-2 text-[15px]","children":[["$","li","Which authority sanctions a plot layout?",{"children":["$","a",null,{"href":"#which-authority-sanctions-a-plot-layout-","className":"text-[var(--sheet-ink)] underline decoration-transparent underline-offset-4 transition-colors hover:decoration-[var(--gold-on-light)]","children":"Which authority sanctions a plot layout?"}]}],["$","li","The five documents that matter",{"children":["$","a",null,{"href":"#the-five-documents-that-matter","className":"text-[var(--sheet-ink)] underline decoration-transparent underline-offset-4 transition-colors hover:decoration-[var(--gold-on-light)]","children":"The five documents that matter"}]}],"$Lc","$Ld","$Le","$Lf"]}]]}]}],"$L10"]}]}],"$L11","$L12"]}]
